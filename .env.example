# Copiază fișierul în .env și completează valorile. NU urca .env pe GitHub!

# Discord Developer Portal -> aplicația ta -> Bot -> Reset Token
DISCORD_TOKEN=
# Discord Developer Portal -> General Information -> Application ID
DISCORD_CLIENT_ID=
# ID-ul serverului de test (click dreapta pe server -> Copy Server ID, cu Developer Mode activ).
# Când e setat, comenzile se înregistrează instant doar pe serverul ăsta.
DISCORD_GUILD_ID=

# console.anthropic.com -> API Keys (necesar pentru /ask)
ANTHROPIC_API_KEY=

# Opțional
DB_PATH=studybot.db
